# Install scripts of dependencies are off: npm runs no preinstall, install or postinstall script of any package.
# The packages that need one are listed in package.json "allowedInstallScripts" and are built by
# `npm run rebuild:native` (`npm run setup` = npm ci + that; build, dev and test run it once when needed).
# `npm run check:install-scripts` (CI) fails when a dependency with an install script is not on that list.
ignore-scripts=true
