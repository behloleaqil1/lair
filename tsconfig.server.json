{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": false
  },
  "include": [
    "src/server/**/*",
    "src/shared/**/*",
    "src/types/**/*",
    "src/bus/**/*",
    "src/cli/**/*",
    "src/node/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/server/delivery/fake-docker.ts"
  ]
}
